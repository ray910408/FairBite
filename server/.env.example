# 複製成 server/.env（已被 .gitignore 排除）後填入實際值。
# 真環境變數優先於本檔，部署時直接由平台注入即可，不需要 .env。

# 必填：Supabase local stack 的 Postgres 連線字串
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# 必填：驗證前端 access token 的 JWKS 端點（ES256）
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json

# 選填：未設定時改用 13 家 mock 餐廳。需在 GCP 啟用 Places API (New)。
GOOGLE_PLACES_API_KEY=

# 選填：CORS 允許來源，預設 http://localhost:5173。只吃單一來源，
# 手機/區網測試時填區網 IP，例如 http://192.168.1.10:5173。
WEB_ORIGIN=

# 選填：預設 Asia/Taipei
APP_TZ=

# 選填：預設 8787
PORT=
